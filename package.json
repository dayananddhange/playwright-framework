{
  "name": "playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Scalable Playwright TypeScript automation framework with POM, fixtures, and environment support",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.13.10",
    "allure-playwright": "^3.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "typescript": "^5.8.2"
  }
}
